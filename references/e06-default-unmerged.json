  "claims": [
    {
      "id": "UNMERGED-1-default-dispatch",
      "kind": "fixed-source guard/def-use deduction",
      "sourceSymbols": [
        "createPort",
        "MERGE_EDGES",
        "MERGE_EDGES_0",
        "HYPERNODE_0",
        "HYPERNODE"
      ],
      "description": "Canonical defaults MERGE_EDGES false and HYPERNODE false make createPort collector condition (mergePorts || node.hypernode) && !sideFixed false before constraints matter. Therefore provideCollectorPort branch is unreachable under explicit scope; missing values are read using generated property aliases, not inferred from host truthiness."
    },
    {
      "id": "UNMERGED-2-two-distinct-ports",
      "kind": "fixed-source allocation deduction",
      "sourceSymbols": [
        "$transformEdge",
        "createPort",
        "LPort",
        "$setNode",
        "$setSide",
        "fromDirection"
      ],
      "description": "No public ports means transformEdge sourceLPort and targetLPort remain null; no edge sections means sourcePoint/targetPoint remain null. Both calls allocate fresh LPort, setNode append, then assign source OUTPUT RIGHT->EAST and target INPUT opposed->WEST. Even a self-loop same node or repeated pair gets two distinct fresh ports per original edge. Each raw port initially has exactly one incident edge and zero size/anchor. Repeated endpoint-node pair does not cause port aliasing/merging."
    },
    {
      "id": "UNMERGED-3-original-edge-identity",
      "kind": "fixed-source allocation/ordered adjacency deduction",
      "sourceSymbols": [
        "$transformEdge",
        "LEdge",
        "$setSource_0",
        "$setTarget_0"
      ],
      "description": "Each transformEdge call creates new LEdge, copies properties, stores ORIGIN original ELKedge, deletes JUNCTION_POINTS via setter(null), then connects source before target using generated append setters. No pair-key deduplication or edge grouping occurs. Parallel graph feature HYPEREDGES test sees per-port degree1 and stays false; same-node equality independently sets SELF_LOOPS. Raw<=28 allocates exactly56 original endpoint ports, never additional original LNode."
    },
    {
      "id": "UNMERGED-4-stage-configuration-observation",
      "kind": "actual-fixed-generated-worker-observation",
      "evidencePointer": "/evidence",
      "description": "Independent parallel2 and parallel28 official requests each run bundled/PRETTY/in-memory instrumented, original args and exact public result/inputAfter; both expose19 actualprocessors and preserve raw edge order/IDs and separate e*_s0 sections. Mixed selfloops add the4 separately reviewed loop processors for23. This is finite observation corroborating source, not all-topology or same-engine determinism proof."
    },
    {
      "id": "UNMERGED-5-bound-and-dependencies",
      "kind": "bounded-host-design/source boundary",
      "sourceSymbols": [
        "$transformEdge",
        "createPort"
      ],
      "description": "Source proof establishes only independent ports/edges/default unmerged dispatch. NS rank, cycle restoration, longedge dummy count, geometry/routing limits and final public export remain separately sourced A/root components. It does not inherit E05 simple-DAG64 proof or promise nondefault merge behavior. No multiedges.py computation should be invented to represent this default-zero branch."
    }
  ],
