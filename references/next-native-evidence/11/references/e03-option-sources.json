  "claims": [
    {
      "id": "defaults-nine",
      "kind": "fixed-source-behavior",
      "sourceIds": [
        "elk-worker",
        "official-option-catalogue"
      ],
      "description": "The nine declaration defaults and metadata targets are recorded in options below. Layered defaults differ from core defaults for some properties."
    },
    {
      "id": "call-replaces-constructor",
      "kind": "fixed-source-behavior",
      "sourceIds": [
        "elk-api"
      ],
      "description": "ELK.layout destructuring uses this.defaultLayoutOptions only when layoutOptions is absent/undefined; an explicit empty object replaces it. Python outer None convenience is a separate host decision."
    },
    {
      "id": "local-over-selected-global",
      "kind": "fixed-source-behavior",
      "sourceIds": [
        "elk-worker"
      ],
      "description": "JsonImporter imports local properties first. optsToCfg adds NO_OVERWRITE; its accept filter rejects overwriting an existing property, so selected global configuration does not replace local values."
    },
    {
      "id": "algorithm-default-vs-fallback",
      "kind": "fixed-source-behavior",
      "sourceIds": [
        "elk-worker"
      ],
      "description": "Algorithm property declares no value. $resolveAlgorithm conditionally tries canonical layered for unconfigured nonempty/inside-self-loop nodes, and can throw if unavailable. A parsed preferred selection is not proof of registration or execution."
    },
    {
      "id": "direction-not-right-default",
      "kind": "fixed-source-behavior",
      "sourceIds": [
        "elk-worker"
      ],
      "description": "Layered property default is UNDEFINED; getDirection_1 resolves direction later using aspect ratio. Option parsing must not eagerly replace it with RIGHT."
    },
    {
      "id": "reference-parser-is-wider",
      "kind": "fixed-source-behavior",
      "sourceIds": [
        "elk-worker"
      ],
      "description": "Reference suffix lookup, parseValue and Spacing.parse_0 support behavior wider than this host slice, including enum ordinals, invalid-value omission and incomplete/loose padding syntax. These are not claimed implemented."
    },
    {
      "id": "strict-host-subset",
      "kind": "host-design",
      "sourceIds": [
        "elk-api",
        "elk-worker"
      ],
      "description": "ADR0002 deliberately supports full IDs/elk aliases, rejects same-scope aliases, unknown and known-unimplemented options separately, and parses only the frozen strict value forms. This is a host rule, not a claim of literal JS parser parity."
    },
    {
      "id": "catalogue-not-registry",
      "kind": "host-design",
      "sourceIds": [
        "official-option-catalogue"
      ],
      "description": "243 embedded canonical names classify diagnostics only. Nine OptionSpec declarations do not register algorithms; runtime performs no references file I/O."
    },
    {
      "id": "per-call-ownership",
      "kind": "host-design",
      "sourceIds": [
        "elk-api"
      ],
      "description": "ExecutionContext snapshots graph/constructor/arguments and creates independent working model/state per call. It saves only configured seed, including zero, without PRNG, Java RNG, layout, scheduling or lifecycle acceptance."
    }
  ],
