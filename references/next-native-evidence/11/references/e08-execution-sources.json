  "claims": [
    {
      "id": "E08-B-SOURCE-01",
      "kind": "fixed-source-behavior",
      "sourceIds": [
        "elkjs-api",
        "elkjs-release-api"
      ],
      "description": "PromisedWorker assigns incrementing message IDs, stores per-ID resolvers, and deletes the matching resolver before forwarding data or converted error. terminate only delegates to the wrapped worker."
    },
    {
      "id": "E08-B-SOURCE-02",
      "kind": "fixed-source-behavior",
      "sourceIds": [
        "elkjs-export-dispatch",
        "elkjs-release-worker"
      ],
      "description": "Dispatcher executes layout synchronously for a received command and returns data/error tagged with that command ID. FakeWorker delays dispatch with setTimeout and has no terminate method."
    },
    {
      "id": "E08-B-SOURCE-03",
      "kind": "fixed-source-behavior",
      "sourceIds": [
        "elkjs-node-entry",
        "elkjs-api-types"
      ],
      "description": "Node entry can construct a real web-worker when requested and installed, otherwise supplies FakeWorker. API typings expose Promise layout and synchronous terminateWorker, without a pending bound or Python timeout/cancellation policy."
    },
    {
      "id": "E08-B-HOST-01",
      "kind": "host-design",
      "sourceIds": [],
      "description": "Per-instance single spawned Python process and bounded FIFO, total pending default16/range1..64, total submission-through-result deadline, short-lived dispatcher thread, and idle loop rebinding implement ADR0007. They are new host design, not a mechanical port of JS scheduling."
    },
    {
      "id": "E08-B-HOST-02",
      "kind": "host-design",
      "sourceIds": [],
      "description": "Strict cloned JSON snapshots cross spawn; existing create_context/validate_slice/layout_context run unchanged. Queued cancellation/timeout never spawns; active cancellation/timeout/close terminates, joins, closes handles and releases the slot before completion. Unknown/malformed envelopes and child failure remain execution errors."
    },
    {
      "id": "E08-B-HOST-03",
      "kind": "host-design",
      "sourceIds": [],
      "description": "Loop publication is the completion race boundary: an already published successful result wins later cancellation. Cancellation requested before publication cancels delivery even when native result and reaping finished. Synchronous close before publication rejects the undelivered result."
    },
    {
      "id": "E08-B-HOST-04",
      "kind": "host-design",
      "sourceIds": [],
      "description": "ObservedTrace append only forwards small progress data and child process_time at existing pipeline phase boundaries, leaving the original trace/phase sequence/algorithm untouched. A completed previous processor is independent of mere process startup. Empty graph legitimately has zero phase trace."
    },
    {
      "id": "E08-B-HOST-05",
      "kind": "host-design",
      "sourceIds": [],
      "description": "snapshot is independent development diagnostics, including actual process liveness, PID, exitcode/reaped and dispatcher liveness. It is not part of returned ELK JSON. No OS RAM/CPU quota or hard cleanup deadline is promised."
    }
  ],
