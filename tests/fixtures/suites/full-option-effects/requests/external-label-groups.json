{
  "schema": "py-elk-layout-request/v1",
  "constructor": {},
  "layoutArguments": {
    "logging": false,
    "measureExecutionTime": false
  },
  "graph": {
    "id": "outer",
    "layoutOptions": {
      "elk.algorithm": "layered",
      "elk.randomSeed": 41
    },
    "children": [
      {
        "id": "container",
        "layoutOptions": {
          "elk.algorithm": "layered",
          "elk.portConstraints": "FIXED_SIDE",
