        "children": [
          {
            "id": "inner",
            "width": 30,
            "height": 20
          }
        ],
        "ports": [
          {
            "id": "external",
            "width": 4,
            "height": 4,
            "layoutOptions": {
              "elk.port.side": "WEST"
            },
            "labels": [
              {
                "id": "extl0",
                "text": "one",
                "width": 8,
                "height": 6
              },
              {
                "id": "extl1",
                "text": "two",
                "width": 27,
                "height": 10
              }
            ]
          }
        ],
        "edges": [
          {
            "id": "entry",
            "sources": [
              "external"
            ],
            "targets": [
              "inner"
            ]
          }
        ]
      }
    ]
  }
}
