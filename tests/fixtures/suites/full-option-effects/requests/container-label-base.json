          "elk.algorithm": "layered",
          "elk.nodeLabels.placement": "[INSIDE,H_CENTER,V_TOP]",
          "elk.nodeLabels.padding": "[top=5,left=5,bottom=5,right=5]"
        },
        "labels": [
          {
            "id": "containerLabel",
            "text": "parent",
            "width": 60,
            "height": 12
          }
        ],
        "children": [
          {
            "id": "inner",
            "width": 30,
            "height": 20
          }
        ]
      }
    ]
  }
}
