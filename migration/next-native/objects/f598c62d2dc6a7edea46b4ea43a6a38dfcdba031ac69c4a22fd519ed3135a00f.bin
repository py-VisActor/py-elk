"""Shared real geometric edge data; triangulation closures are staged separately.

Only the reviewed constructor is currently needed by rectangle-boundary math.
This does not substitute an unimplemented triangulation algorithm.
"""


class TEdge:
    def __init__(self, first, second):
        self.u = first
        self.v = second
