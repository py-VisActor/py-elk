# Uses the separately attributed GWT source_sort from layered.ports; see
# NOTICE-GWT-Ports.md. No GWT/EMF runtime or text measurement is implemented.
"""Actual generic node micro layout over one persistent JSON layout session.

These adapters use the common node-size process while retaining the generic
ElkGraphAdapter's own compound, property, ordering and margin semantics. They
do not run the layered graph importer or select an input-size admission domain.
"""
from collections.abc import MutableMapping, Mapping
import json

from ..algorithms.layered.graph import Insets, Vec2
from ..algorithms.layered.ports import _source_sort, double_compare
from ..algorithms.layered.cell_layout import _maximum
from ..options.schema import OPTION_SPECS, OptionSpec, Padding, Vector2
from ..options.resolution import _canonical_id, _parse
from ..options.element import parse_mapping
from .._errors import OptionValidationError

_PREFIX = 'org.eclipse.elk.'
_NAMES = {
    'DIRECTION':'direction', 'PADDING':'padding', 'MARGINS':'margins',
    'PORT_CONSTRAINTS':'portConstraints', 'PORT_SIDE':'port.side', 'PORT_INDEX':'port.index',
    'PORT_BORDER_OFFSET':'port.borderOffset', 'PORT_ANCHOR':'port.anchor',
    'NODE_SIZE_CONSTRAINTS':'nodeSize.constraints', 'NODE_SIZE_OPTIONS':'nodeSize.options',
    'NODE_SIZE_MINIMUM':'nodeSize.minimum', 'NODE_SIZE_FIXED_GRAPH_SIZE':'nodeSize.fixedGraphSize',
    'NODE_LABELS_PLACEMENT':'nodeLabels.placement', 'NODE_LABELS_PADDING':'nodeLabels.padding',
    'PORT_LABELS_PLACEMENT':'portLabels.placement', 'PORT_LABELS_TREAT_AS_GROUP':'portLabels.treatAsGroup',
    'PORT_ALIGNMENT_DEFAULT':'portAlignment.default',
    **{'PORT_ALIGNMENT_'+s.upper():'portAlignment.'+s for s in ('north','east','south','west')},
    'SPACING_PORT_PORT':'spacing.portPort', 'SPACING_LABEL_LABEL':'spacing.labelLabel',
    'SPACING_LABEL_NODE':'spacing.labelNode', 'SPACING_LABEL_PORT_HORIZONTAL':'spacing.labelPortHorizontal',
    'SPACING_LABEL_PORT_VERTICAL':'spacing.labelPortVertical', 'SPACING_PORTS_SURROUNDING':'spacing.portsSurrounding',
    'SPACING_INDIVIDUAL':'spacing.individual', 'TOPDOWN_LAYOUT':'topdownLayout',
    'INSIDE_SELF_LOOPS_ACTIVATE':'insideSelfLoops.activate', 'INSIDE_SELF_LOOPS_YO':'insideSelfLoops.yo',
    'EDGE_LABELS_PLACEMENT':'edgeLabels.placement',
}


def _native(value):
    if isinstance(value, Vector2): return Vec2(value.x,value.y)
    if isinstance(value, Padding): return Insets(value.top,value.right,value.bottom,value.left)
    if isinstance(value, frozenset): return set(value)
    if isinstance(value, Mapping): return {k:_native(v) for k,v in value.items()}
    return value


def _minimum(*values): return -_maximum(*(-v for v in values))


def _spec(name):
    spec=OPTION_SPECS[_PREFIX+name]
    # The old bounded parser schemas are not the generic Core parser/domain.
    if name=='padding': return OptionSpec(spec.id,spec.alias,'insets',spec.declared_default,spec.targets)
    if name=='direction': return OptionSpec(spec.id,spec.alias,'enum_ordinal',spec.declared_default,spec.targets,spec.accepted_values)
    if name=='port.borderOffset': return OptionSpec(spec.id,spec.alias,'signed_number',0,spec.targets)
    return spec


class _PropertyReader:
    def __init__(self,state):
        self.state=state
        if not hasattr(state,'_micro_removed'): state._micro_removed=set()

    def _lookup(self,values,spec,path):
        found=[]
        for spelling,value in values.items():
            if spelling==spec.id or spec.id.endswith('.'+spelling):
                if _canonical_id(spelling,path+'/'+spelling)==spec.id: found.append(value)
            elif spelling==spec.alias: found.append(value)
        if len(found)>1: raise OptionValidationError('AMBIGUOUS_OPTION',path,'Two aliases for one property')
        return (True,found[0]) if found else (False,None)

    def _local(self,data,spec):
        options=data.get('layoutOptions',data.get('properties',{}))
        return self._lookup(options,spec,self.state.paths.get(id(data),''))

    def _global(self,kind,spec):
        targets={'node':{'NODES','PARENTS'},'port':{'PORTS'},'edge':{'EDGES'},'label':{'LABELS'}}[kind]
        if not targets.intersection(spec.targets): return False,None
        return self._lookup(self.state.options,spec,'/selectedGlobalOptions')

    def has(self,data,kind,name):
        if name=='nodeSize.constraints' and id(data) in self.state.cleared_constraints: return True
        if name in self.state.computed_options.get(id(data),{}): return True
        if (id(data),name) in self.state._micro_removed: return False
        if name=='spacing.individual' and kind=='node' and 'individualSpacings' in data: return True
        spec=_spec(name)
        return self._local(data,spec)[0] or self._global(kind,spec)[0]

    def _convert(self,spec,value,*,internal=False,global_value=False):
        if internal:
            if spec.kind=='vector' and isinstance(value,Mapping): return Vec2(value['x'],value['y'])
            if spec.kind=='insets' and isinstance(value,Mapping): return Insets(**value)
            if spec.kind=='enumset' and type(value) is set: return value
            if spec.kind=='enumset' and isinstance(value,(list,tuple,frozenset)): return set(value)
            if spec.kind=='individual_spacings' and type(value) is dict: return value
            return _native(value)
        if global_value and type(value) in (dict,list): value=json.dumps(value,separators=(',',':'),allow_nan=False)
        return _native(_parse(spec,value,'/microProperties/'+spec.id))

    def get(self,data,kind,name):
        spec=_spec(name);computed=self.state.computed_options.setdefault(id(data),{})
        if name=='nodeSize.constraints' and id(data) in self.state.cleared_constraints: return set()
        if name in computed:
            value=self._convert(spec,computed[name],internal=True);computed[name]=value;return value
        removed=(id(data),name) in self.state._micro_removed
        local,value=self._local(data,spec) if not removed else (False,None)
        if name=='spacing.individual' and kind=='node' and 'individualSpacings' in data and not removed:
            holder=self._convert(spec,value) if local else {}
            extra,_=parse_mapping(data['individualSpacings'],'/individualSpacings')
            holder.update({k:_native(v) for k,v in extra.items()});value=holder
        elif local: value=self._convert(spec,value)
        else:
            present,value=self._global(kind,spec) if not removed else (False,None)
            if present: value=self._convert(spec,value,global_value=True)
            elif self.state.resolve_option is not None and not removed:
                value=self._convert(spec,self.state.resolve_option(data,name,spec.declared_default),internal=True)
            else: value=_native(spec.declared_default)
        # The source caches cloneable defaults, and all explicit imported values
        # exist independently of the original raw JSON. Primitive defaults do
        # not gain hasProperty merely because they were requested.
        if local or self.has(data,kind,name) or isinstance(value,(Vec2,Insets,set,dict)):
            computed[name]=value
        return value


class _Properties(MutableMapping):
    def __init__(self,reader,data,kind,compound=None,inside=None):
        self.reader=reader;self.data=data;self.kind=kind;self.compound=compound;self.inside=inside
    def __getitem__(self,key):
        if key=='COMPOUND_NODE' and self.compound is not None: return self.compound()
        if key=='INSIDE_CONNECTIONS' and self.inside is not None: return self.inside()
        if key not in _NAMES: raise KeyError(key)
        return self.reader.get(self.data,self.kind,_NAMES[key])
    def get(self,key,default=None):
        try: return self[key]
        except KeyError: return default
    def __contains__(self,key):
        if key=='COMPOUND_NODE': return self.compound is not None
        if key=='INSIDE_CONNECTIONS': return self.inside is not None
        return key in _NAMES and self.reader.has(self.data,self.kind,_NAMES[key])
    def __setitem__(self,key,value):
        name=_NAMES[key]
        if value is None: self.__delitem__(key);return
        self.reader.state._micro_removed.discard((id(self.data),name))
        self.reader.state.computed_options.setdefault(id(self.data),{})[name]=value
    def __delitem__(self,key):
        name=_NAMES[key];self.reader.state.computed_options.setdefault(id(self.data),{}).pop(name,None)
        self.reader.state._micro_removed.add((id(self.data),name))
    def __iter__(self): return (key for key in _NAMES if key in self)
    def __len__(self): return sum(1 for _ in self)


class _Shape:
    def __init__(self,reader,data,kind):
        self.data=data;self.pos=Vec2(data.get('x',0),data.get('y',0))
        self.size=Vec2(data.get('width',0),data.get('height',0));self.id=0
        self.properties=_Properties(reader,data,kind)
    def commit(self):
        self.data.update(x=self.pos.x,y=self.pos.y,width=self.size.x,height=self.size.y)


class _Port(_Shape):
    def __init__(self,reader,data,owner):
        super().__init__(reader,data,'port');self.owner=owner;self.reader=reader
        self.properties.inside=self._inside
        self.incoming_edges=reader.state.incidence(data,True);self.outgoing_edges=reader.state.incidence(data)
        self.labels=[_Shape(reader,raw,'label') for raw in data.get('labels',[])]
    @property
    def side(self): return self.properties['PORT_SIDE']
    def _inside(self):
        state=self.reader.state;node=self.owner.data
        for edges,endpoints in ((self.outgoing_edges,'targets'),(self.incoming_edges,'sources')):
            for edge in edges:
                for identifier in edge[endpoints]:
                    target=state.owners[id(state.shapes[(type(identifier),identifier)])]
                    if state._ancestor(target,node): return True
                    if target is node and self.reader.get(edge,'edge','insideSelfLoops.yo'): return True
        return False
    def commit(self):
        super().commit()
        for label in self.labels: label.commit()


class _Node(_Shape):
    def __init__(self,reader,data,graph):
        super().__init__(reader,data,'node');self.graph=graph;self.type='NORMAL'
        self.properties.compound=lambda: bool(data.get('children') or self.properties['INSIDE_SELF_LOOPS_ACTIVATE'])
        self.ports=[_Port(reader,raw,self) for raw in data.get('ports',[])]
        self.labels=[_Shape(reader,raw,'label') for raw in data.get('labels',[])]
    @property
    def padding(self): return self.properties['PADDING']
    @property
    def margin(self): return self.properties['MARGINS']
    def commit(self):
        super().commit()
        for port in self.ports: port.commit()
        for label in self.labels: label.commit()


def _sort_ports(node):
    if node.properties['PORT_CONSTRAINTS'] not in ('FIXED_ORDER','FIXED_RATIO','FIXED_POS'): return
    sides=('UNDEFINED','NORTH','EAST','SOUTH','WEST')
    def compare(first,second):
        order=sides.index(first.side)-sides.index(second.side)
        if order: return order
        a,b=first.properties['PORT_INDEX'],second.properties['PORT_INDEX']
        if a is not None and b is not None and a!=b: return a-b
        if first.side=='NORTH': return double_compare(first.pos.x,second.pos.x)
        if first.side=='EAST': return double_compare(first.pos.y,second.pos.y)
        if first.side=='SOUTH': return double_compare(second.pos.x,first.pos.x)
        if first.side=='WEST': return double_compare(second.pos.y,first.pos.y)
        raise ValueError('Port side is undefined')
    _source_sort(node.ports,compare)
    if 'ports' in node.data: node.data['ports'][:]=[p.data for p in node.ports]


def _union(box,other):
    x1=_minimum(box[0],other[0]);y1=_minimum(box[1],other[1])
    x2=_maximum(box[0]+box[2],other[0]+other[2]);y2=_maximum(box[1]+box[3],other[1]+other[3])
    if x2<x1: x1,x2=x2,x1
    if y2<y1: y1,y2=y2,y1
    box[:]=[x1,y1,x2-x1,y2-y1]


def _edge_label_bounds(reader,node,port,space,spacing,box):
    state=reader.state
    endpoints=((state.incidence(port.data),state.incidence(port.data,True)) if port is not None else
               (state.node_edges(node.data),state.node_edges(node.data,True)))
    for edges,incoming in ((endpoints[0],False),(endpoints[1],True)):
        for edge in edges:
            for raw in edge.get('labels',[]):
                if reader.get(raw,'label','edgeLabels.placement')!=('HEAD' if incoming else 'TAIL'): continue
                x,y=node.pos.x,node.pos.y;w,h=raw['width'],raw['height']
                if port is None: x=x-spacing-w if incoming else x+node.size.x+spacing
                else:
                    x+=port.pos.x;y+=port.pos.y
                    if port.side in ('UNDEFINED','EAST'): x+=port.size.x+spacing+space.x+spacing
                    elif port.side=='WEST': x-=spacing+space.x+spacing+w
                    elif port.side=='NORTH': x+=port.size.x+spacing;y-=spacing+space.y+spacing+h
                    elif port.side=='SOUTH': x+=port.size.x+spacing;y+=port.size.y+spacing+space.y+spacing
                _union(box,[x,y,w,h])


def _node_margin(reader,node,spacing):
    box=[node.pos.x,node.pos.y,node.size.x,node.size.y]
    for label in node.labels: _union(box,[node.pos.x+label.pos.x,node.pos.y+label.pos.y,label.size.x,label.size.y])
    for port in node.ports:
        px,py=node.pos.x+port.pos.x,node.pos.y+port.pos.y
        _union(box,[px,py,port.size.x,port.size.y])
        for label in port.labels: _union(box,[px+label.pos.x,py+label.pos.y,label.size.x,label.size.y])
        space=Vec2(-spacing,-spacing)
        if 'OUTSIDE' in node.properties['PORT_LABELS_PLACEMENT']:
            for label in port.labels:
                space.x+=label.size.x+spacing;space.y+=label.size.y+spacing
        space.x=_maximum(space.x,0);space.y=_maximum(space.y,0)
        _edge_label_bounds(reader,node,port,space,spacing,box)
    # This intentionally repeats port edges through the node's all-edge view,
    # as the original margin caller does; do not deduplicate the two passes.
    _edge_label_bounds(reader,node,None,None,spacing,box)
    node.properties['MARGINS']=Insets(_maximum(0,node.pos.y-box[1]),
        _maximum(0,box[0]+box[2]-(node.pos.x+node.size.x)),
        _maximum(0,box[1]+box[3]-(node.pos.y+node.size.y)),_maximum(0,node.pos.x-box[0]))


def node_micro_layout(state,node):
    """Run the real default generic micro pipeline on this parent's children."""
    from ..algorithms.layered.node_size_process import process_node_size
    reader=_PropertyReader(state)
    class Graph:
        properties=_Properties(reader,node,'node')
        options=None
    graph=Graph();children=[_Node(reader,raw,graph) for raw in node.get('children',[])]
    for child in children: _sort_ports(child)
    for child in children:
        process_node_size(graph,child,True,False,transparent_north_south_edges=False)
        child.commit()
    spacing=graph.properties['SPACING_LABEL_NODE']
    for child in children: _node_margin(reader,child,spacing)
